{
  "name": "ghumne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:feedback": "node scripts/test-feedback.mjs",
    "test:feedback:production": "node scripts/test-feedback.mjs --production",
    "test:home": "node scripts/test-feedback.mjs --homepage",
    "prepare:reference-qa": "node scripts/prepare-reference-qa.mjs",
    "db:check": "node scripts/check-sql.mjs",
    "supabase:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "supabase:dev:check": "node --env-file-if-exists=.env.local scripts/check-dev-target.mjs",
    "db:tests:prepare": "node --env-file-if-exists=.env.local scripts/prepare-db-tests.mjs",
    "db:first:prepare": "node --env-file-if-exists=.env.local scripts/prepare-first-migration.mjs --prepare",
    "db:first:check": "node --env-file-if-exists=.env.local scripts/prepare-first-migration.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@libpg-query/parser": "17.6.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
