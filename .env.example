# Copy this file to .env.local at the project root.
# Supabase project Connect dialog / Settings > API Keys:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Both values above are browser-visible configuration.
# Use an sb_publishable_ key. Never use a secret or service-role key here.
# No privileged key is required for the server/browser clients.
# Restart the dev server after changes; rebuild deployed apps after public values change.
